# SafePath Backend Environment Variables Example
ENVIRONMENT=development
PROJECT_NAME=SafePath
API_V1_STR=/api/v1

# PostgreSQL + PostGIS Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safepath_db
POSTGRES_USER=safepath_user
POSTGRES_PASSWORD=safepath_password_dev

# Redis Cache & Ephemeral Session Store
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Secret Keys (Placeholders for local dev)
SECRET_KEY=dev_secret_key_change_in_production_safepath_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

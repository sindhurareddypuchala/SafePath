# SafePath Backend Environment Variables Example
ENVIRONMENT=development
PROJECT_NAME=SafePath
API_V1_STR=/api/v1

# PostgreSQL + PostGIS Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safepath_db
POSTGRES_USER=safepath_user
POSTGRES_PASSWORD=safepath_password_dev

# Redis Cache & Ephemeral Session Store
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Secret Keys (Placeholders for local dev)
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
